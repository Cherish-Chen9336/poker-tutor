+            // poker-tutor patch: levels created only by folded players' investments
+            // share the same eligible seats. Merge them into one pot so the pot is
+            // split once; splitting each level separately misassigns odd chips.
+            const previous = pots[pots.length - 1];
+            if (previous &&
+                previous.eligibleSeats.length === eligibleSeats.length &&
+                previous.eligibleSeats.every((seat, index) => seat === eligibleSeats[index])) {
+                pots[pots.length - 1] = {
+                    ...previous,
+                    amount: previous.amount + potAmount,
+                    capPerPlayer: current.amount,
+                };
+            }
+            else {
+                pots.push({
+                    amount: potAmount,
+                    eligibleSeats,
+                    type: pots.length === 0 ? "MAIN" : "SIDE",
